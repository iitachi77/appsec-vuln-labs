# Hardened configuration — the config half of the fix.
# The single most important line in this file for CVE-2021-3129 is APP_DEBUG=false.

APP_NAME=LumosBlog
APP_ENV=production
APP_KEY=                 # set via `php artisan key:generate`, kept secret, never committed
APP_DEBUG=false          # <-- was true. Debug off = no Ignition error pages, no execute-solution surface.
APP_URL=https://lumosblog.example

# Also fix the dependency (the other root cause):
#   composer require "facade/ignition:^2.5.2"      # patched line for Laravel 8
#   # or, on Laravel 9+:  remove facade/ignition, use spatie/laravel-ignition (maintained & patched)

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=sqlite
DB_DATABASE=/app/database/database.sqlite

CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_SECURE_COOKIE=true
