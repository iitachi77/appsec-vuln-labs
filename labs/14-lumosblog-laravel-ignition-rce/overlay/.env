APP_NAME=LumosBlog
APP_ENV=production
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:9012

# single file log (storage/logs/laravel.log) — classic Ignition RCE log-poison target
LOG_CHANNEL=single
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=/app/database/database.sqlite

CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=log
